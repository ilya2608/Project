# --- Postgres ---
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda
POSTGRES_DB=agenda
DATABASE_URL=postgresql+psycopg://agenda:agenda@db:5432/agenda

# --- App ---
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false          # set true in production (HTTPS only)
CLINIC_TIMEZONE=Europe/Brussels
SECRET_KEY=change-me-dev-only

# --- itsme OIDC ---
# Leave these blank to automatically use the built-in mock itsme login for
# local development/demos. Populate them with real itsme partner credentials
# to switch to the real itsme login — no code changes required.
ITSME_ISSUER=
ITSME_CLIENT_ID=
ITSME_CLIENT_SECRET=
ITSME_REDIRECT_URI=http://localhost:8000/api/v1/auth/itsme/callback
ITSME_SCOPES=openid profile

# --- Frontend build-time ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
